generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  projects  Project[]

  @@map("users")
}

model Agent {
  id                 String   @id
  name               String
  role               String
  model              String
  capabilities       Json     @db.JsonB
  maxConcurrency     Int      @map("max_concurrency")
  currentLoad        Int      @default(0) @map("current_load")
  historicalSuccessRate Float @default(0.75) @map("historical_success_rate")
  available          Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("agents")
}

model AgentDefinition {
  id                String                   @id
  name              String
  purpose           String
  discoveryTagsJson Json                     @map("discovery_tags_json") @db.JsonB
  status            String
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  versions          AgentDefinitionVersion[]

  @@index([status])
  @@index([discoveryTagsJson], type: Gin)
  @@map("agent_definitions")
}

model AgentDefinitionVersion {
  id                String            @id
  agentDefinitionId String            @map("agent_definition_id")
  version           Int
  specJson          Json              @map("spec_json") @db.JsonB
  checksum          String
  status            String
  createdAt         DateTime          @default(now()) @map("created_at")
  publishedAt       DateTime?         @map("published_at")
  deprecatedAt      DateTime?         @map("deprecated_at")
  agentDefinition   AgentDefinition   @relation(fields: [agentDefinitionId], references: [id], onDelete: Restrict)
  teamMembers       AgentTeamMember[]

  @@unique([agentDefinitionId, version])
  @@index([status])
  @@map("agent_definition_versions")
}

model AgentTeamVersion {
  id              String               @id
  name            String
  version         Int
  specJson        Json                 @map("spec_json") @db.JsonB
  checksum        String
  status          String
  createdAt       DateTime             @default(now()) @map("created_at")
  publishedAt     DateTime?            @map("published_at")
  members         AgentTeamMember[]
  projectBindings ProjectTeamBinding[]

  @@unique([name, version])
  @@index([status])
  @@map("agent_team_versions")
}

model AgentTeamMember {
  teamVersionId            String                 @map("team_version_id")
  memberId                 String                 @map("member_id")
  agentDefinitionVersionId String                 @map("agent_definition_version_id")
  instanceCount            Int                    @map("instance_count")
  position                 Int
  teamVersion              AgentTeamVersion       @relation(fields: [teamVersionId], references: [id], onDelete: Cascade)
  agentDefinitionVersion   AgentDefinitionVersion @relation(fields: [agentDefinitionVersionId], references: [id], onDelete: Restrict)

  @@id([teamVersionId, memberId])
  @@index([agentDefinitionVersionId])
  @@map("agent_team_members")
}

model ProjectTeamBinding {
  projectId     String           @id @map("project_id")
  teamVersionId String           @map("team_version_id")
  frozenJson    Json             @map("frozen_json") @db.JsonB
  createdAt     DateTime         @default(now()) @map("created_at")
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamVersion   AgentTeamVersion @relation(fields: [teamVersionId], references: [id], onDelete: Restrict)

  @@index([teamVersionId])
  @@map("project_team_bindings")
}

model ProjectMemoryEntry {
  id        String   @id
  projectId String   @map("project_id")
  kind      String
  key       String
  valueJson Json     @map("value_json") @db.JsonB
  source    String
  createdAt DateTime @default(now()) @map("created_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, kind, key])
  @@map("project_memory_entries")
}

model Project {
  id           String   @id
  ownerId      String?  @map("owner_id")
  name         String
  requirement  String
  lastEventSeq Int      @default(0) @map("last_event_seq")
  createdAt    DateTime @default(now()) @map("created_at")
  owner        User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  tasks        Task[]
  dependencies TaskDependency[]
  journal      TaskJournal[]
  decisions    SchedulerDecision[]
  executions   Execution[]
  verifications VerificationReport[]
  repairs      RepairRecord[]
  workflow     WorkflowRun?
  runs         ProjectRun[]
  events       ProductEvent[]
  lease        WorkflowLease?
  teamBinding  ProjectTeamBinding?
  memoryEntries ProjectMemoryEntry[]
  workflowControlRun WorkflowControlRun?
  workflowControlEvents WorkflowControlEvent[]

  @@map("projects")
}

model Task {
  id           String
  projectId    String @map("project_id")
  title        String
  description  String
  role         String
  priority     Int
  requiredCapabilities Json @map("required_capabilities") @db.JsonB
  writeScopes  Json   @map("write_scopes") @db.JsonB
  pageId       String? @map("page_id")
  snapshotJson Json   @map("snapshot_json") @db.JsonB
  revision     Int
  status       String
  retryCount   Int    @default(0) @map("retry_count")
  assignedAgentId String? @map("assigned_agent_id")
  position     Int
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  outgoingDependencies TaskDependency[] @relation("TaskDependencySource")
  incomingDependencies TaskDependency[] @relation("TaskDependencyTarget")
  journal      TaskJournal[]

  @@id([projectId, id])
  @@index([projectId, status])
  @@map("tasks")
}

model TaskDependency {
  projectId        String @map("project_id")
  taskId           String @map("task_id")
  dependsOnTaskId  String @map("depends_on_task_id")
  project          Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task             Task @relation("TaskDependencySource", fields: [projectId, taskId], references: [projectId, id], onDelete: Cascade)
  dependsOnTask    Task @relation("TaskDependencyTarget", fields: [projectId, dependsOnTaskId], references: [projectId, id], onDelete: Cascade)

  @@id([projectId, taskId, dependsOnTaskId])
  @@map("task_dependencies")
}

model TaskJournal {
  seq         BigInt   @id @default(autoincrement())
  projectId   String   @map("project_id")
  taskId      String   @map("task_id")
  revision    Int
  eventType   String   @map("event_type")
  reason      String?
  snapshotJson Json    @map("snapshot_json") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task        Task     @relation(fields: [projectId, taskId], references: [projectId, id], onDelete: Cascade)

  @@unique([projectId, taskId, revision])
  @@index([projectId, seq])
  @@map("task_journal")
}

model SchedulerDecision {
  seq          BigInt   @id @default(autoincrement())
  id           String   @unique
  projectId    String   @map("project_id")
  taskId       String   @map("task_id")
  decisionJson Json     @map("decision_json") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at")
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, seq])
  @@map("scheduler_decisions")
}

model Execution {
  id          String   @id
  projectId   String   @map("project_id")
  taskId      String   @map("task_id")
  agentId     String   @map("agent_id")
  sessionId   String?  @map("session_id")
  status      String
  startedAt   DateTime @map("started_at")
  completedAt DateTime? @map("completed_at")
  errorJson   Json?    @map("error_json") @db.JsonB
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events      ExecutionEvent[]

  @@index([projectId, taskId])
  @@map("executions")
}

model ExecutionEvent {
  seq         BigInt   @id @default(autoincrement())
  executionId String   @map("execution_id")
  eventType   String   @map("event_type")
  payloadJson Json     @map("payload_json") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at")
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, seq])
  @@map("execution_events")
}

model VerificationReport {
  id               String   @id
  projectId        String   @map("project_id")
  taskId           String?  @map("task_id")
  status           String
  failureSignature String?  @map("failure_signature")
  reportJson       Json     @map("report_json") @db.JsonB
  createdAt        DateTime @default(now()) @map("created_at")
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repairs          RepairRecord[]

  @@index([projectId, createdAt])
  @@map("verification_reports")
}

model RepairRecord {
  id                   String   @id
  projectId            String   @map("project_id")
  repairRound          Int      @map("repair_round")
  verificationReportId String   @map("verification_report_id")
  repairAgentId        String   @map("repair_agent_id")
  failureSignature     String   @map("failure_signature")
  errorSummary         String   @map("error_summary")
  changeSummary        String   @map("change_summary")
  diff                 String
  beforeStatus         String   @map("before_status")
  afterStatus          String   @map("after_status")
  startedAt            DateTime @map("started_at")
  completedAt          DateTime @map("completed_at")
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  verification         VerificationReport @relation(fields: [verificationReportId], references: [id])

  @@unique([projectId, repairRound])
  @@index([projectId, repairRound])
  @@map("repair_records")
}

model WorkflowRun {
  id                String   @id
  projectId         String   @unique @map("project_id")
  status            String
  repairRound       Int      @map("repair_round")
  escalationReason  String?  @map("escalation_reason")
  escalationMessage String?  @map("escalation_message")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("workflow_runs")
}

model ProjectRun {
  id            String    @id
  projectId     String    @map("project_id")
  status        String
  ownerId       String    @map("owner_id")
  fencingToken  BigInt    @map("fencing_token")
  workspacePath String    @map("workspace_path")
  previewPath   String?   @map("preview_path")
  startedAt     DateTime  @map("started_at")
  completedAt   DateTime? @map("completed_at")
  errorJson     Json?     @map("error_json") @db.JsonB
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, startedAt])
  @@map("project_runs")
}

model ProductEvent {
  id          String   @id
  projectId   String   @map("project_id")
  seq         Int
  type        String
  taskId      String?  @map("task_id")
  agentId     String?  @map("agent_id")
  payloadJson Json     @map("payload_json") @db.JsonB
  occurredAt  DateTime @map("occurred_at")
  createdAt   DateTime @default(now()) @map("created_at")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  outbox      OutboxEvent?

  @@unique([projectId, seq])
  @@index([projectId, seq])
  @@map("product_events")
}

model OutboxEvent {
  eventId        String    @id @map("event_id")
  publishedAt    DateTime? @map("published_at")
  claimOwnerId   String?   @map("claim_owner_id")
  claimToken     String?   @map("claim_token")
  claimedAt      DateTime? @map("claimed_at")
  claimExpiresAt DateTime? @map("claim_expires_at")
  event          ProductEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([publishedAt, claimExpiresAt])
  @@map("outbox_events")
}

model WorkflowLease {
  resourceId   String   @id @map("resource_id")
  projectId    String   @unique @map("project_id")
  ownerId      String?  @map("owner_id")
  fencingToken BigInt   @default(0) @map("fencing_token")
  heartbeatAt  DateTime @map("heartbeat_at")
  expiresAt    DateTime @map("expires_at")
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("workflow_leases")
}

model WorkflowDefinition {
  id          String
  version     Int
  graphJson   Json                 @map("graph_json") @db.JsonB
  checksum    String
  status      String
  createdAt   DateTime             @default(now()) @map("created_at")
  publishedAt DateTime?            @map("published_at")
  controlRuns WorkflowControlRun[]

  @@id([id, version])
  @@index([status])
  @@map("workflow_definitions")
}

model WorkflowControlRun {
  projectId         String             @id @map("project_id")
  definitionId      String             @map("definition_id")
  definitionVersion Int                @map("definition_version")
  snapshotJson      Json               @map("snapshot_json") @db.JsonB
  status            String
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  definition        WorkflowDefinition @relation(fields: [definitionId, definitionVersion], references: [id, version], onDelete: Restrict)

  @@index([definitionId, definitionVersion])
  @@index([status])
  @@map("workflow_control_runs")
}

model WorkflowControlEvent {
  seq       BigInt   @id @default(autoincrement())
  projectId String   @map("project_id")
  entrySeq  Int      @map("entry_seq")
  eventType String   @map("event_type")
  eventJson Json     @map("event_json") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, entrySeq])
  @@index([projectId, seq])
  @@map("workflow_control_events")
}

{
  "name": "@deepseek-ai/dsh-experimental-future-cup-platform",
  "description": "Future Cup management application, real Harness team launcher, API, realtime events, and Prisma PostgreSQL persistence",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/future-cup-platform"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "prisma.config.ts",
    "prisma/schema.prisma",
    "prisma/migrations/**",
    "lib/web/**",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "listedByDefault": false,
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build:ui": "vite build --config ui/vite.config.ts",
    "postinstall": "prisma generate",
    "test:ui": "vitest run --config ui/vitest.config.ts",
    "typecheck:ui": "tsc -p ui/tsconfig.json --pretty false"
  },
  "dependencies": {
    "@deepseek-ai/dsh-experimental-future-cup-orchestration": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@fastify/static": "10.1.8",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "socket.io": "4.8.4",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@ant-design/icons": "6.3.4",
    "@deepseek-ai/cordis": "workspace:~",
    "@testing-library/react": "^16.3.3",
    "@types/pg": "^8.15.5",
    "@vitejs/plugin-react": "^4.7.0",
    "@xyflow/react": "12.12.0",
    "antd": "6.6.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.5",
    "socket.io-client": "4.8.4",
    "vite": "^6.4.3"
  }
}

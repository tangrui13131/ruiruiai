{
  "name": "@deepseek-ai/dsh-experimental-future-cup-platform",
  "description": "Future Cup platform API, realtime event delivery, and Prisma PostgreSQL persistence",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/future-cup-platform"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "prisma.config.ts",
    "prisma/schema.prisma",
    "prisma/migrations/**",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "listedByDefault": false,
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@deepseek-ai/dsh-experimental-future-cup-orchestration": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "socket.io": "4.8.4",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@types/pg": "^8.15.5",
    "socket.io-client": "4.8.4"
  }
}

{
  "name": "@deepseek-ai/dsh-experimental-future-cup-orchestration",
  "description": "Durable DAG, explainable scheduling, and real Harness Agent team orchestration for the Future Cup frontend platform",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/future-cup-orchestration"
  },
  "type": "module",
  "main": "lib/index.js",
